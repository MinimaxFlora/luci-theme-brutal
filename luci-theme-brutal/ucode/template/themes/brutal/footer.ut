{% if (!blank_page): %}
					</div>
				</main>

				<footer>
					<div class="footer-content">
						<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">Powered by {{ version.luciname }} ({{ version.luciversion }})</a>
						<span class="footer-sep" aria-hidden="true">|</span>
						<a href="https://github.com/MinimaxFlora/luci-theme-brutal" target="_blank" rel="noreferrer">BrutalTheme v1.3.3</a>
						<span class="footer-sep" aria-hidden="true">|</span>
						<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }}{% if (version.distrevision): %} ({{ version.distrevision }}){% endif %}</a>
					</div>
				</footer>
			</div>
		</div>
		<script>L.require('menu-brutal')</script>
		<script>L.require('brutal-appearance')</script>
		{% endif %}
	</body>
</html>

{% include('header', { blank_page: true }) %}

{%
	import { cursor } from 'uci';
	import * as fs from 'fs';

	const cfg = cursor();
	const cfgval = function(key, fallback) {
		return cfg.get_first('brutal', 'global', key) ??
		       cfg.get_first('brutal', 'login', key) ?? fallback;
	};
	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const firmware = striptags(`${version.distname ?? 'OpenWrt'} ${version.distversion ?? ''}`);
	const bg_on = cfgval('background', '1') != '0';

	const bg_dir = '/www/luci-static/brutal/background';

	function pick_wallpaper(configured) {
		if (configured && configured != 'random')
			return configured;

		let names = [];

		try {
			names = fs.lsdir(bg_dir) ?? [];
		}
		catch (e) {
			names = [];
		}

		let usable = [];

		for (let i = 0; i < length(names); i++) {
			let name = names[i];

			if (match(name, /\.(jpe?g|png|gif|webp|mp4|webm)$/i))
				push(usable, name);
		}

		if (!length(usable))
			return media + '/img/bg1.webp';

		return media + '/background/' + usable[(+time()) % length(usable)];
	}

	let wallpaper = pick_wallpaper(cfgval('wallpaper', 'random'));

	if (cfgval('online_wallpaper', 'none') != 'none') {
		const online = ubus.call('luci.brutal_wallpaper', 'get_url') ?? {};

		if (online.url)
			wallpaper = online.url;
	}

	const bg_video = match(wallpaper, /\.(mp4|webm)$/i) != null;
	const branding_dir = '/www' + media + '/branding';
	const has_logo = fs.access(branding_dir + '/logo.png');
	const logo_mtime = has_logo ? (fs.stat(branding_dir + '/logo.png')?.mtime ?? '') : '';
	const logo_url = has_logo ? (media + '/branding/logo.png?v=' + logo_mtime) : (media + '/logo.svg');
	const login_style = (cfgval('login_style', 'classic') == 'centered') ? 'centered' : 'classic';
	const glass_on = cfgval('glass', '1') != '0';

	function clampf(value, low, high) {
		value = +value;
		return (value < low) ? low : ((value > high) ? high : value);
	}

	const blur = clampf(cfgval('blur', '10'), 0, 100);
	const transparency = clampf(cfgval('transparency', '0.5'), 0, 1);
-%}

{% if (bg_on): %}
<div class="login-bg" aria-hidden="true">
	{% if (bg_video): %}
	<video autoplay muted loop playsinline preload="metadata" poster="{{ media }}/img/bg1.webp">
		<source src="{{ entityencode(wallpaper, true) }}" type="video/{{ match(wallpaper, /\.webm$/i) ? 'webm' : 'mp4' }}">
	</video>
	{% else %}
	<img src="{{ entityencode(wallpaper, true) }}" alt="">
	{% endif %}
</div>
{% endif %}

<main class="login-page{{ bg_on ? ' has-bg' : '' }}" data-style="{{ login_style }}" data-glass="{{ glass_on ? '1' : '0' }}"
	style="--br-blur:{{ blur }}px;--br-glass-alpha:{{ sprintf('%.0f%%', transparency * 100) }}">
	<div class="login-card">
		<div class="login-brand">
			<img class="login-logo" src="{{ entityencode(logo_url, true) }}" alt="">
			<span class="login-host">{{ hostname }}</span>
		</div>

		<form method="post" action="{{ entityencode(http.getenv("REQUEST_URI"), true) }}" class="login-form">
			{% if (fuser): %}
			<div class="alert-message error" role="alert">
				{{ _('Invalid username and/or password! Please try again.') }}
			</div>
			{% endif %}

			<div class="cbi-value">
				<label class="cbi-value-title" for="luci_username">{{ _('Username') }}</label>
				<div class="cbi-value-field">
					<input name="luci_username" id="luci_username" type="text" autocomplete="username"
						autocapitalize="none" spellcheck="false" value="{{ entityencode(duser, true) }}">
				</div>
			</div>

			<div class="cbi-value">
				<label class="cbi-value-title" for="luci_password">{{ _('Password') }}</label>
				<div class="cbi-value-field">
					<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
				</div>
			</div>

			<button type="submit" class="btn cbi-button-positive important">{{ _('Log in') }}</button>
		</form>

		<p class="login-foot">{{ firmware }} / {{ version.luciname }} {{ version.luciversion }}</p>
	</div>
</main>

<script>
	(function() {
		var input = document.querySelector('input[name="luci_password"]');

		if (input)
			input.focus();
	})();
</script>

{% include('footer', { blank_page: true }) %}

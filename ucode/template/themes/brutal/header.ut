{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const distname = striptags(version?.distname ?? 'OpenWrt');
	const distversion = striptags(version?.distversion ?? '');
	const distrevision = striptags(version?.distrevision ?? '');
	const luciname = striptags(version?.luciname ?? 'LuCI');
	const luciversion = striptags(version?.luciversion ?? '');
	const pagetitle = dispatched?.title ? ` | ${_(dispatched.title)}` : '';
	// First-child routes resolve to a deeper page while keeping the entry URL.
	const page_path = length(ctx.path) > length(ctx.request_path) ? ctx.path : ctx.request_path;

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${hostname}${pagetitle}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light">
		<meta name="theme-color" content="#000000">
		<meta name="darkreader-lock">
		<meta name="robots" content="noindex, nofollow">
		<meta name="referrer" content="strict-origin-when-cross-origin">
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="stylesheet" media="only screen and (max-device-width: 854px)" href="{{ media }}/mobile.css" />
		<link rel="icon" href="{{ media }}/logo_48.png" sizes="48x48">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }}{{ blank_page ? ' page-blank' : '' }}" data-page="{{ entityencode(join('-', page_path), true) }}">
		{% if (!blank_page): %}
		<a class="skip-link" href="#maincontent">{{ _('Skip to content') }}</a>

		<header>
			<a class="brand" href="/" title="{{ hostname }}">
				<span class="brand-mark" aria-hidden="true"></span>
				<span class="brand-name">{{ hostname }}</span>
				<span class="brand-suffix">LuCI</span>
			</a>

			<span class="header-tag">LuCI // BRUTAL</span>

			<button type="button" class="nav-toggle" id="navtoggle" aria-expanded="false" aria-controls="mainmenu" aria-label="{{ entityencode(_('Toggle navigation'), true) }}">
				<span class="nav-toggle-icon" aria-hidden="true"></span>
				<span class="nav-toggle-label">{{ _('Menu') }}</span>
			</button>
		</header>

		<div class="statusbar">
			<span class="statusbar-item statusbar-dist">{{ distname }} {{ distversion }}</span>
			<span class="statusbar-item statusbar-luci">{{ luciname }} {{ luciversion }}</span>
			{% if (length(distrevision)): %}
			<span class="statusbar-rev">BUILD {{ distrevision }}</span>
			{% endif %}
			<div id="indicators"></div>
		</div>

		<div id="navscrim" class="nav-scrim" aria-hidden="true"></div>

		<div class="shell">
			<aside id="mainmenu" class="sidebar" style="display:none" aria-label="{{ entityencode(_('Main navigation'), true) }}"></aside>

			<div class="shell-content">
				<div id="maincontent" class="container" tabindex="-1">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message warning">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == "initramfs"): %}
					<div class="alert-message warning">
						<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
						<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
						{% if (dispatcher.lookup("admin/system/flash")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
						{% endif %}
					</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" class="tabmenu" style="display:none"></div>
		{% endif %}

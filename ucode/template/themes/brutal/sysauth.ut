{% include('header', { blank_page: true }) %}

{%
	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const firmware = striptags(`${version.distname ?? 'OpenWrt'} ${version.distversion ?? ''}`);
-%}

<main class="login-page">
	<div class="login-card">
		<div class="login-head">
			<span class="login-stamp" aria-hidden="true">BRUTAL</span>
			<h1 class="login-title">LuCI</h1>
			<p class="login-note">{{ hostname }} // ROUTER CONTROL</p>
		</div>

		<form method="post" action="{{ entityencode(http.getenv("REQUEST_URI"), true) }}" class="login-form">
			{% if (fuser): %}
			<div class="alert-message error" role="alert">
				{{ _('Invalid username and/or password! Please try again.') }}
			</div>
			{% endif %}

			<div class="cbi-value">
				<label class="cbi-value-title" for="luci_username">{{ _('Username') }}</label>
				<div class="cbi-value-field">
					<input name="luci_username" id="luci_username" type="text" autocomplete="username"
						autocapitalize="none" spellcheck="false" value="{{ entityencode(duser, true) }}">
				</div>
			</div>

			<div class="cbi-value">
				<label class="cbi-value-title" for="luci_password">{{ _('Password') }}</label>
				<div class="cbi-value-field">
					<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
				</div>
			</div>

			<button type="submit" class="btn cbi-button-positive important">{{ _('Log in') }}</button>
		</form>

		<p class="login-foot">{{ firmware }} / {{ version.luciname }} {{ version.luciversion }}</p>
	</div>
</main>

<script>
	(function() {
		var input = document.querySelector('input[name="luci_password"]');

		if (input)
			input.focus();
	})();
</script>

{% include('footer', { blank_page: true }) %}
